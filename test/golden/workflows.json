{
  "ci.yml": {
    "name": "CI",
    "on": {
      "push": {
        "branches": [
          "main"
        ]
      },
      "pull_request": {
        "branches": [
          "main"
        ]
      }
    },
    "permissions": {
      "contents": "read"
    },
    "jobs": {
      "check": {
        "uses": "1mb-dev/.github/.github/workflows/ci-node.yml@main",
        "with": {
          "node-versions": "[\"22\", \"24\", \"26\"]",
          "run-build": "false",
          "run-audit": "false"
        }
      }
    }
  },
  "deploy.yml": {
    "name": "Deploy",
    "on": {
      "push": {
        "branches": [
          "main"
        ]
      }
    },
    "permissions": {
      "contents": "read"
    },
    "concurrency": {
      "group": "deploy",
      "cancel-in-progress": "false"
    },
    "jobs": {
      "build": {
        "runs-on": "ubuntu-latest",
        "steps": [
          {
            "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
            "with": {
              "persist-credentials": "false"
            }
          },
          {
            "uses": "actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1",
            "with": {
              "node-version": "24",
              "package-manager-cache": "false"
            }
          },
          {
            "run": "npm ci --ignore-scripts"
          },
          {
            "run": "npm test"
          },
          {
            "run": "npm run audit"
          },
          {
            "run": "npm run site -- --deploy",
            "env": {
              "TURNSTILE_SITEKEY": "${{ vars.TURNSTILE_SITEKEY }}"
            }
          },
          {
            "uses": "actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9",
            "with": {
              "name": "site",
              "path": "dist/site",
              "if-no-files-found": "error",
              "retention-days": "1"
            }
          }
        ]
      },
      "deploy": {
        "needs": "build",
        "runs-on": "ubuntu-latest",
        "environment": "production",
        "steps": [
          {
            "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
            "with": {
              "persist-credentials": "false"
            }
          },
          {
            "uses": "actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1",
            "with": {
              "node-version": "24",
              "package-manager-cache": "false"
            }
          },
          {
            "run": "npm ci --ignore-scripts"
          },
          {
            "uses": "actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333",
            "with": {
              "name": "site",
              "path": "dist/site"
            }
          },
          {
            "name": "the artifact is what site.js writes",
            "run": "node scripts/artifact.js dist/site"
          },
          {
            "name": "wrangler pages deploy",
            "run": "node_modules/.bin/wrangler pages deploy dist/site --branch main",
            "env": {
              "CLOUDFLARE_API_TOKEN": "${{ secrets.CLOUDFLARE_API_TOKEN }}",
              "CLOUDFLARE_ACCOUNT_ID": "${{ secrets.CLOUDFLARE_ACCOUNT_ID }}"
            }
          },
          {
            "id": "smoke",
            "run": "node scripts/smoke.js"
          },
          {
            "if": "failure() && steps.smoke.outcome == 'failure'",
            "run": "echo \"::error::smoke failed after the deploy, so this build is live in production. Roll back in the dashboard (Workers & Pages > bareflow > Deployments) to the last green deployment.\""
          }
        ]
      }
    }
  },
  "probe.yml": {
    "name": "Probe",
    "on": {
      "schedule": [
        {
          "cron": "17 * * * *"
        }
      ],
      "workflow_dispatch": null
    },
    "permissions": {
      "contents": "read"
    },
    "jobs": {
      "probe": {
        "runs-on": "ubuntu-latest",
        "steps": [
          {
            "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
            "with": {
              "persist-credentials": "false"
            }
          },
          {
            "uses": "actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1",
            "with": {
              "node-version": "24",
              "package-manager-cache": "false"
            }
          },
          {
            "run": "node scripts/smoke.js --probe"
          }
        ]
      }
    }
  },
  "publish.yml": {
    "name": "Publish",
    "on": {
      "push": {
        "tags": [
          "v*"
        ]
      }
    },
    "permissions": {
      "contents": "read"
    },
    "jobs": {
      "check": {
        "runs-on": "ubuntu-latest",
        "steps": [
          {
            "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
            "with": {
              "persist-credentials": "false"
            }
          },
          {
            "uses": "actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1",
            "with": {
              "node-version": "24",
              "package-manager-cache": "false"
            }
          },
          {
            "run": "npm ci --ignore-scripts"
          },
          {
            "run": "npm test"
          },
          {
            "run": "npm run audit"
          }
        ]
      },
      "publish": {
        "needs": "check",
        "runs-on": "ubuntu-latest",
        "environment": "npm",
        "permissions": {
          "contents": "read",
          "id-token": "write"
        },
        "steps": [
          {
            "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
            "with": {
              "fetch-depth": "0",
              "persist-credentials": "false"
            }
          },
          {
            "uses": "actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1",
            "with": {
              "node-version": "24",
              "package-manager-cache": "false"
            }
          },
          {
            "name": "the tag is a plain version, the package's",
            "run": "grep -Eq '^v[0-9]+\\.[0-9]+\\.[0-9]+$' <<< \"$GITHUB_REF_NAME\" && test \"$GITHUB_REF_NAME\" = \"v$(node -p 'require(\"./package.json\").version')\""
          },
          {
            "name": "the tagged commit is on main",
            "run": "git merge-base --is-ancestor \"$GITHUB_SHA\" origin/main"
          },
          {
            "run": "npm publish --ignore-scripts --provenance"
          }
        ]
      },
      "release": {
        "needs": "publish",
        "runs-on": "ubuntu-latest",
        "permissions": {
          "contents": "write"
        },
        "steps": [
          {
            "run": "gh release create \"$GITHUB_REF_NAME\" --draft --verify-tag --generate-notes --repo \"$GITHUB_REPOSITORY\"",
            "env": {
              "GH_TOKEN": "${{ github.token }}"
            }
          }
        ]
      }
    }
  }
}
