{
  "name": "bareflow",
  "version": "0.5.0",
  "description": "Deterministic, faithful, versioned document layer for technical web content",
  "keywords": [
    "markdown",
    "documentation",
    "html-to-markdown",
    "llm",
    "agents",
    "cli"
  ],
  "homepage": "https://github.com/1mb-dev/bareflow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1mb-dev/bareflow.git"
  },
  "bugs": {
    "url": "https://github.com/1mb-dev/bareflow/issues"
  },
  "author": "Vinayak Mishra (https://github.com/vnykmshr)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "bareflow": "./bin/bareflow.js"
  },
  "files": [
    "bin",
    "src",
    "!src/verify.js",
    "!src/truth.js",
    "!src/edge.js",
    "docs",
    "NOTICE"
  ],
  "scripts": {
    "bareflow": "node bin/bareflow.js",
    "verify": "node src/verify.js",
    "bundle": "node scripts/bundle.js",
    "site": "node scripts/site.js",
    "parity": "node scripts/parity.js",
    "contact": "node scripts/contact.js",
    "smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "defuddle": "0.19.4",
    "htmlparser2": "^10.0.0",
    "linkedom": "0.18.12"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "0.28.2",
    "marked": "18.0.14"
  }
}
