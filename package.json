    "verify": "node src/verify.js",
    "bundle": "node scripts/bundle.js"
  },
  "dependencies": {
    "defuddle": "0.19.4",
    "linkedom": "0.18.12"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "0.28.2",
    "marked": "18.0.14"
  }
}
