{
  "name": "bareflow",
  "version": "0.5.0",
  "description": "A docs page as Markdown or typed JSON, with a note for each loss it detects",
  "keywords": [
    "markdown",
    "documentation",
    "html-to-markdown",
    "llm",
    "agents",
    "cli",
    "mcp"
  ],
  "homepage": "https://bareflow.1mb.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1mb-dev/bareflow.git"
  },
  "bugs": {
    "url": "https://github.com/1mb-dev/bareflow/issues"
  },
  "author": "1mb.dev",
  "type": "module",
  "engines": {
    "node": ">=22.15"
  },
  "bin": {
    "bareflow": "./bin/bareflow.js"
  },
  "files": [
    "bin",
    "src",
    "!src/verify.js",
    "!src/truth.js",
    "!src/edge.js",
    "docs/ir.md",
    "NOTICE",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "test": "node src/verify.js",
    "verify": "node src/verify.js",
    "bundle": "node scripts/bundle.js",
    "site": "node scripts/site.js",
    "parity": "node scripts/parity.js",
    "contact": "node scripts/contact.js",
    "smoke": "node scripts/smoke.js",
    "audit": "npm audit --audit-level=moderate && npm audit signatures"
  },
  "dependencies": {
    "defuddle": "0.19.4",
    "htmlparser2": "^10.0.0",
    "linkedom": "0.18.12",
    "turndown": "7.2.4"
  },
  "license": "MIT",
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "esbuild": "0.28.2",
    "marked": "18.0.14",
    "wrangler": "4.153.0"
  }
}
